        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (redpanda_group) (redpanda_kafka_consumer_group_lag_sum{namespace=\"sentinel\"})",
          "legendFormat": "{{redpanda_group}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 15,
      "title": "Processing time p95",
      "description": "Time to handle one message, 95th percentile.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
