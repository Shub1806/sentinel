          },
          "expr": "sum(rate(payments_processed_total{namespace=\"sentinel\", status=\"failed\"}[$__rate_interval]))",
          "legendFormat": "payments failed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(payments_invalid_messages_total{namespace=\"sentinel\"}[$__rate_interval]))",
